# 后端本机运行参数示例；只包含无敏感信息的默认值，正式配置通过环境变量提供
ZQKY_API_HOST=127.0.0.1
ZQKY_API_PORT=8000
ZQKY_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:5174
ZQKY_ENV=development

# 设置页保存的 API Key 写入后端 apps/api/.env，重启后自动恢复。
# 也可手动填写，后缀使用设置页显示的连接 ID（每个连接独立，不按模型名匹配）。
# 手动修改后重启 API；同名进程环境变量在启动时优先。不要使用 NEXT_PUBLIC_。
ZQKY_API_KEY_CONNECTION_ID=
